PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (mongodb+srv://...)
MONGO_URI=

# Any long random string — used to sign login tokens
JWT_SECRET=

# Used to build absolute links (e.g. in emails); set to your Vercel URL
FRONTEND_URL=

# Optional — complaint photo uploads fall back to local disk storage
# (which does NOT persist on most hosts) until these are set
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
